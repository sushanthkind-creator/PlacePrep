# Copy this file to .env and fill in your own values. Never commit .env.

# Long random strings. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string

# SQLite file inside backend/instance/ by default. Use a PostgreSQL URL to migrate later.
DATABASE_URL=sqlite:///placeprep.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long a login lasts.
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Optional: enables "Continue with Google". Leave empty to hide the button.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# add http://localhost:5173 to its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
